@@ -18,16 +18,137 @@ from fsdp_turbo.utils.torch_patch import apply_hccl_premul_sum_patch
 logger = logging.getLogger(__name__)
 
 
+def _validate_efsdp_ep_ownership(
+    model: torch.nn.Module,
+    ep_plan: EPPlanConfig,
+    efsdp_modules: list[torch.nn.Module],
+) -> None:
+    """Reject eFSDP targets that are not owned by an EP target.
+
+    The eFSDP mesh intentionally excludes the EP axis.  That is correct for
+    expert tensors because EP partitions them, but it leaves independent,
+    unsynchronized copies when a replicated router/shared/latent MoE module is
+    placed on the same mesh.  Those copies only start to differ after the first
+    optimizer update, which makes this configuration error look like an online
+    weight-loading or train/inference numerical problem.
+    """
+
+    ep_roots: list[torch.nn.Module] = []
+    for pattern in ep_plan.apply_modules:
+        ep_roots.extend(
+            module
+            for name, module in model.named_modules()
+            if module_name_match(pattern, name)
+        )
+
+    ep_owned = {
+        id(module)
+        for root in ep_roots
+        for module in root.modules()
+    }
+    names_by_id = {id(module): name for name, module in model.named_modules()}
+    invalid = sorted(
+        names_by_id.get(id(module), f"<{type(module).__name__}>")
+        for module in efsdp_modules
+        if id(module) not in ep_owned
+    )
+    if invalid:
+        raise RuntimeError(
+            "[Expert Fully Shard] apply_efsdp_modules contains modules outside "
+            "the expert-parallel ownership domain. The edp x efsdp mesh does "
+            "not synchronize replicated gradients across EP ranks. Put the "
+            "common enclosing MoE module in fsdp_plan.apply_modules (while "
+            "keeping only the EP-owned experts in apply_efsdp_modules); do not "
+            "wrap replicated MoE children individually because their world "
+            "AllGather may overlap the EP AllToAllV. Invalid targets: "
+            f"{invalid}"
+        )
+
+
+def _validate_fsdp_ep_collective_boundaries(
+    model: torch.nn.Module,
+    ep_plan: EPPlanConfig,
+    fsdp_plan: FSDPPlanConfig,
+) -> dict[str, int]:
+    """Reject world-FSDP hooks interleaved inside an EP MoE invocation.
+
+    HCCL's AIV kernels cannot safely execute collectives from multiple process
+    groups at the same time.  A world-FSDP wrapper on a router/shared/latent
+    child can launch AllGather while the sibling EP experts still have an
+    AllToAllV in flight.  Wrapping an enclosing MoE/layer is safe: its gather
+    happens before entering the EP region, and its forward scope does not end
+    until that region and all replicated projections have returned.
+    """
+
+    named_modules = list(model.named_modules())
+    ep_targets = {
+        name
+        for pattern in (ep_plan.apply_modules or [])
+        for name, _ in named_modules
+        if module_name_match(pattern, name)
+    }
+    fsdp_targets = {
+        name
+        for pattern in (fsdp_plan.apply_modules or {})
+        for name, _ in named_modules
+        if module_name_match(pattern, name)
+    }
+
+    interleaved: set[str] = set()
+    enclosed = 0
+    for ep_name in ep_targets:
+        moe_parent, separator, _ = ep_name.rpartition('.')
+        if not separator:
+            continue
+        prefix = f"{moe_parent}."
+        for fsdp_name in fsdp_targets:
+            # The enclosing parent (or a still-higher ancestor such as the
+            # decoder layer) is the desired boundary. Descendant siblings are
+            # hooks executed from inside the EP-containing forward.
+            if ep_name.startswith(f"{fsdp_name}."):
+                enclosed += 1
+            if fsdp_name.startswith(prefix) and not (
+                fsdp_name == ep_name or fsdp_name.startswith(f"{ep_name}.")
+            ):
+                interleaved.add(fsdp_name)
+
+    if interleaved:
+        rendered = sorted(interleaved)
+        preview = rendered[:16]
+        suffix = "" if len(rendered) <= len(preview) else f" (+{len(rendered) - len(preview)} more)"
+        raise RuntimeError(
+            "[FSDP/EP topology] world-FSDP targets are interleaved inside an "
+            "EP-containing MoE forward. Their AllGather may overlap EP "
+            "AllToAllV when HCCL AIV expansion is enabled. Wrap the common "
+            f"enclosing MoE/layer instead: {preview}{suffix}"
+        )
+
+    return {
+        "ep_targets": len(ep_targets),
+        "world_fsdp_targets": len(fsdp_targets),
+        "enclosed_ep_targets": enclosed,
+        "interleaved_targets": 0,
+    }
+
+
 def expert_fully_shard_modules(
     model: torch.nn.Module, efsdp_mesh, ep_plan: EPPlanConfig, fsdp_plan: FSDPPlanConfig
 ) -> torch.nn.Module:
+    topology = _validate_fsdp_ep_collective_boundaries(model, ep_plan, fsdp_plan)
+    print_rank(
+        logger.info,
+        "[FSDP/EP topology] SAFE ACTIVE: "
+        + ", ".join(f"{key}={value}" for key, value in topology.items()),
+    )
     efsdp_modules = get_efsdp_modules(model, ep_plan)
+    _validate_efsdp_ep_ownership(model, ep_plan, efsdp_modules)
     efsdp_hook_modules = get_fsdp_hook_modules(model, fsdp_plan)
     offload_policy = get_offload_policy(fsdp_plan)
     config = {
         'mesh': efsdp_mesh,
         'mp_policy': MixedPrecisionPolicy(param_dtype=torch.bfloat16, reduce_dtype=torch.float32),
         'offload_policy': offload_policy,
+        'reshard_after_forward': fsdp_plan.reshard_after_forward,
         'shard_placement_fn': lambda x: Shard(1) if x.dim() > 1 else Shard(0),
     }
 
