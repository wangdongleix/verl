+def _align_kimi_full_model_routes(
+    routed_experts: torch.Tensor,
+    routed_expert_weights: torch.Tensor,
+    router_replay_mask: torch.Tensor,
+    target_attention_mask: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Align natural-rollout routes to Kimi's final model-row axis.
+
+    vLLM returns one route row for every row that actually entered a model
+    forward: the complete image-expanded prompt and each generated-token
+    predecessor. The last sampled response token has not itself been
+    forwarded, so a valid capture must contain exactly one fewer row than the
+    final FSDP input. Mapping is order-preserving over valid attention rows and
+    therefore remains correct under left padding and variable image expansion.
+    """
+    if routed_experts.dim() != 4:
+        raise ValueError(
+            "full-model routed_experts must be [batch, rows, layers, topk], "
+            f"got {tuple(routed_experts.shape)}"
+        )
+    if router_replay_mask.shape != routed_experts.shape[:2]:
+        raise ValueError(
+            "full-model router_replay_mask must match the route row axis, "
+            f"got mask={tuple(router_replay_mask.shape)} and "
+            f"routes={tuple(routed_experts.shape[:2])}"
+        )
+    if routed_expert_weights.shape != routed_experts.shape:
+        raise ValueError(
+            "full-model routed_expert_weights must be elementwise aligned "
+            f"with expert IDs, got ids={tuple(routed_experts.shape)}, "
+            f"weights={tuple(routed_expert_weights.shape)}"
+        )
+    if not routed_expert_weights.is_floating_point():
+        raise TypeError(
+            "full-model routed_expert_weights must be floating point, got "
+            f"{routed_expert_weights.dtype}"
+        )
+    if target_attention_mask.dim() != 2 or target_attention_mask.shape[0] != routed_experts.shape[0]:
+        raise ValueError(
+            "full-model target attention mask must be [batch, expanded_rows], "
+            f"got {tuple(target_attention_mask.shape)}"
+        )
+
+    target_device = target_attention_mask.device
+    source_routes = routed_experts.to(target_device)
+    source_weights = routed_expert_weights.to(target_device)
+    source_mask = router_replay_mask.to(device=target_device, dtype=torch.bool)
+    target_mask = target_attention_mask.to(device=target_device, dtype=torch.bool)
+    aligned_routes = source_routes.new_zeros(
+        source_routes.shape[0],
+        target_mask.shape[1],
+        source_routes.shape[2],
+        source_routes.shape[3],
+    )
+    aligned_weights = source_weights.new_zeros(
+        source_weights.shape[0],
+        target_mask.shape[1],
+        source_weights.shape[2],
+        source_weights.shape[3],
+    )
+    aligned_mask = torch.zeros_like(target_mask, dtype=torch.bool)
+    total_source_rows = 0
+    positive_sum_min = None
+    positive_sum_max = None
+    for batch_idx in range(source_routes.shape[0]):
+        source_rows = torch.where(source_mask[batch_idx])[0]
+        target_rows = torch.where(target_mask[batch_idx])[0]
+        expected_source_rows = max(int(target_rows.numel()) - 1, 0)
+        if int(source_rows.numel()) != expected_source_rows:
+            raise ValueError(
+                "Kimi full-model R3 requires rollout_rows == "
+                "expanded_training_rows - 1: "
+                f"sample={batch_idx}, rollout_rows={source_rows.numel()}, "
+                f"expanded_training_rows={target_rows.numel()}, "
+                f"route_width={source_routes.shape[1]}, "
+                f"expanded_width={target_mask.shape[1]}"
+            )
+        if expected_source_rows:
+            causal_target_rows = target_rows[:-1]
+            aligned_routes[batch_idx, causal_target_rows] = source_routes[
+                batch_idx, source_rows
+            ]
+            aligned_weights[batch_idx, causal_target_rows] = source_weights[
+                batch_idx, source_rows
+            ]
+            aligned_mask[batch_idx, causal_target_rows] = True
+            copied_routes = aligned_routes[batch_idx, causal_target_rows]
+            copied_weights = aligned_weights[batch_idx, causal_target_rows]
+            original_routes = source_routes[batch_idx, source_rows]
+            original_weights = source_weights[batch_idx, source_rows]
+            if not torch.equal(copied_routes, original_routes):
+                raise RuntimeError(
+                    "Kimi full-model R3 alignment changed expert IDs: "
+                    f"sample={batch_idx}, source_rows={int(source_rows.numel())}"
+                )
+            if not torch.equal(copied_weights, original_weights):
+                max_difference = float(
+                    (copied_weights.float() - original_weights.float())
+                    .abs()
+                    .max()
+                    .item()
+                )
+                raise RuntimeError(
+                    "Kimi full-model R3 alignment changed router weights: "
+                    f"sample={batch_idx}, source_rows={int(source_rows.numel())}, "
+                    f"max_abs_diff={max_difference}"
+                )
+            total_source_rows += int(source_rows.numel())
+            sums = original_weights.float().sum(dim=-1)
+            positive_sums = sums[sums > 0]
+            if positive_sums.numel():
+                current_min = positive_sums.min()
+                current_max = positive_sums.max()
+                positive_sum_min = (
+                    current_min
+                    if positive_sum_min is None
+                    else torch.minimum(positive_sum_min, current_min)
+                )
+                positive_sum_max = (
+                    current_max
+                    if positive_sum_max is None
+                    else torch.maximum(positive_sum_max, current_max)
+                )
+
+    global _KIMI_FULL_R3_ALIGN_LOGGED
+    if total_source_rows and not _KIMI_FULL_R3_ALIGN_LOGGED:
+        rank = (
+            torch.distributed.get_rank()
+            if torch.distributed.is_available() and torch.distributed.is_initialized()
+            else 0
+        )
+        marker = (
+            "FSDP Kimi full-model R3 ALIGNMENT ACTIVE: "
+            f"rank={rank} samples={source_routes.shape[0]} "
+            f"source_rows={total_source_rows} ids_copy_exact=True "
+            "weights_copy_exact=True integrity_stage=post_model_row_alignment "
+            f"positive_weight_sum_min="
