index 0000000..c082e19
--- /dev/null
+++ b/tests/training/test_clip_grads_nonfinite.py
@@ -0,0 +1,44 @@
+import importlib.util
+import math
+from pathlib import Path
+
+import pytest
+import torch
+
+
+_MODULE_PATH = (
+    Path(__file__).resolve().parents[2]
+    / "fsdp_turbo"
+    / "training"
+    / "clip_grads.py"
+)
+_SPEC = importlib.util.spec_from_file_location("kimi_test_clip_grads", _MODULE_PATH)
+clip_grads = importlib.util.module_from_spec(_SPEC)
+assert _SPEC.loader is not None
+_SPEC.loader.exec_module(clip_grads)
+
+
+@pytest.mark.parametrize("total_norm", [math.nan, math.inf, -math.inf])
+def test_nonfinite_norm_does_not_poison_finite_gradients(total_norm):
+    parameter = torch.nn.Parameter(torch.ones(4))
+    parameter.grad = torch.tensor([1.0, -2.0, 3.0, -4.0])
+    original = parameter.grad.clone()
+
+    clip_grads.clip_grad_by_norm([parameter], max_norm=1.0, total_norm=total_norm)
+
+    torch.testing.assert_close(parameter.grad, original)
+    assert torch.isfinite(parameter.grad).all()
+
+
+def test_finite_norm_is_still_clipped():
+    parameter = torch.nn.Parameter(torch.ones(2))
+    parameter.grad = torch.tensor([3.0, 4.0])
+
+    clip_grads.clip_grad_by_norm([parameter], max_norm=1.0, total_norm=5.0)
+
+    torch.testing.assert_close(
+        parameter.grad,
+        torch.tensor([0.6, 0.8]),
+        rtol=1e-5,
+        atol=1e-6,
+    )
diff --git a/tests/unit_tests/training/test_clip_grads.py b/tests/unit_tests/training/test_clip_grads.py
new file mode 100644
index 0000000..cac090e
--- /dev/null
+++ b/tests/unit_tests/training/test_clip_grads.py
@@ -0,0 +1,30 @@
+import math
+
+import pytest
+import torch
+
+from fsdp_turbo.training.clip_grads import compute_grad_norm
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
+@pytest.mark.parametrize("norm_type", [1.0, 1.5, 2.0, float("inf")])
+def test_compute_grad_norm_matches_flat_fp32_reference(dtype, norm_type):
+    generator = torch.Generator().manual_seed(7)
+    parameters = []
+    flat_grads = []
+    for shape in ((13, 17), (9,), (2, 3, 5)):
+        parameter = torch.nn.Parameter(torch.empty(shape, dtype=dtype))
+        parameter.grad = torch.randn(shape, generator=generator, dtype=torch.float32).to(dtype)
+        parameters.append(parameter)
+        flat_grads.append(parameter.grad.float().reshape(-1))
+
+    actual = compute_grad_norm(parameters, norm_type)
+    expected = torch.linalg.vector_norm(
+        torch.cat(flat_grads), ord=norm_type, dtype=torch.float32
+    ).item()
+
+    assert math.isclose(actual, expected, rel_tol=2e-6, abs_tol=2e-6)
+
+
+def test_compute_grad_norm_without_gradients_is_zero():
+    assert compute_grad_norm([torch.nn.Parameter(torch.ones(3))]) == 0.0
