index 0000000..5550d0e
--- /dev/null
+++ b/tests/distributed/test_efsdp_ep_ownership.py
@@ -0,0 +1,66 @@
+from types import SimpleNamespace
+import unittest
+
+import torch
+
+from fsdp_turbo.distributed.expert_parallel.expert_fully_shard_parallel import (
+    _validate_efsdp_ep_ownership,
+    _validate_fsdp_ep_collective_boundaries,
+)
+
+
+class _Moe(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.experts = torch.nn.ModuleList([torch.nn.Linear(2, 2)])
+        self.gate = torch.nn.Linear(2, 2)
+        self.shared_experts = torch.nn.Linear(2, 2)
+
+
+class _Model(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.moe = _Moe()
+
+
+class TestEfsdpEpOwnership(unittest.TestCase):
+    def setUp(self):
+        self.model = _Model()
+        self.plan = SimpleNamespace(apply_modules=["moe.experts"])
+
+    def test_ep_module_and_descendants_are_valid(self):
+        _validate_efsdp_ep_ownership(
+            self.model,
+            self.plan,
+            [self.model.moe.experts, self.model.moe.experts[0]],
+        )
+
+    def test_replicated_moe_module_is_rejected(self):
+        with self.assertRaisesRegex(RuntimeError, "moe.shared_experts"):
+            _validate_efsdp_ep_ownership(
+                self.model,
+                self.plan,
+                [self.model.moe.experts, self.model.moe.shared_experts],
+            )
+
+    def test_enclosing_world_fsdp_boundary_is_safe(self):
+        topology = _validate_fsdp_ep_collective_boundaries(
+            self.model,
+            self.plan,
+            SimpleNamespace(apply_modules={"moe": {}}),
+        )
+        self.assertEqual(topology["ep_targets"], 1)
+        self.assertEqual(topology["enclosed_ep_targets"], 1)
+        self.assertEqual(topology["interleaved_targets"], 0)
+
+    def test_replicated_child_world_fsdp_boundary_is_rejected(self):
+        with self.assertRaisesRegex(RuntimeError, "moe.shared_experts"):
+            _validate_fsdp_ep_collective_boundaries(
+                self.model,
+                self.plan,
+                SimpleNamespace(apply_modules={"moe.shared_experts": {}}),
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
