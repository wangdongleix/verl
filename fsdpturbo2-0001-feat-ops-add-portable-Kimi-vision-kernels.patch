@@ -0,0 +1,69 @@
+# Copyright (c) 2026, Huawei Technologies Co., Ltd.
+# Licensed under the Apache License, Version 2.0 (the "License");
+
+from collections.abc import Sequence
+
+import torch
+import torch.nn.functional as F
+
+from fsdp_turbo.ops.registry import register_op
+
+
+@register_op("canonical_nd", "cpu")
+def canonical_nd_cpu(tensor: torch.Tensor) -> torch.Tensor:
+    """Keep CPU tensors in their existing dense storage."""
+    return tensor
+
+
+@register_op("try_fused_vision_attention", "cpu")
+def try_fused_vision_attention_cpu(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    cu_seqlens: torch.Tensor | Sequence[int],
+    scale: float,
+) -> torch.Tensor | None:
+    """Use the caller's portable attention path when no fused kernel exists."""
+    return
+
+
+@register_op("vision_attention", "cpu")
+def vision_attention_cpu(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    q_cu_seqlens: torch.Tensor | Sequence[int],
+    k_cu_seqlens: torch.Tensor | Sequence[int],
+    scale: float,
+) -> torch.Tensor:
+    """Apply independent non-causal attention to each packed image."""
+    query_ends = list(q_cu_seqlens)
+    key_ends = list(k_cu_seqlens)
+    if query_ends and query_ends[0] == 0:
+        query_ends = query_ends[1:]
+    if key_ends and key_ends[0] == 0:
+        key_ends = key_ends[1:]
+    if len(query_ends) != len(key_ends):
+        raise ValueError("Query and key sequence counts must match")
+    outputs = []
+    query_start = key_start = 0
+    for query_end, key_end in zip(query_ends, key_ends):
+        query_end, key_end = int(query_end), int(key_end)
+        outputs.append(
+            F.scaled_dot_product_attention(
+                q[query_start:query_end].transpose(0, 1),
+                k[key_start:key_end].transpose(0, 1),
+                v[key_start:key_end].transpose(0, 1),
+                scale=scale,
+            ).transpose(0, 1)
+        )
+        query_start, key_start = query_end, key_end
+    return torch.cat(outputs, dim=0)
+
+
+@register_op("rotary_interleaved", "cpu")
+def rotary_interleaved_cpu(inputs: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
+    """Rotate adjacent feature pairs using the supplied sine and cosine."""
+    pairs = inputs.reshape(*inputs.shape[:-1], -1, 2)
+    rotated = torch.stack((-pairs[..., 1], pairs[..., 0]), dim=-1).reshape_as(inputs)
+    return inputs * cos + rotated * sin
