+# Copyright (c) 2026, Huawei Technologies Co., Ltd.
+# Licensed under the Apache License, Version 2.0 (the "License");
+
+from collections.abc import Sequence
+
+import torch
+
+from fsdp_turbo.ops.registry import dispatch_op
+
+
+def canonical_nd(tensor: torch.Tensor) -> torch.Tensor:
+    """Return canonical storage while preserving gradients."""
+    return dispatch_op("canonical_nd", tensor, device_type=tensor.device.type)
+
+
+def try_fused_vision_attention(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    cu_seqlens: torch.Tensor | Sequence[int],
+    scale: float,
+) -> torch.Tensor | None:
+    """Return fused no-grad attention, or None for the portable caller path."""
+    return dispatch_op(
+        "try_fused_vision_attention",
+        q,
+        k,
+        v,
+        cu_seqlens,
+        scale,
+        device_type=q.device.type,
+    )
+
+
+def vision_attention(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    q_cu_seqlens: torch.Tensor | Sequence[int],
+    k_cu_seqlens: torch.Tensor | Sequence[int],
+    scale: float,
+) -> torch.Tensor:
+    """Compute non-causal attention over packed vision sequences."""
+    return dispatch_op(
+        "vision_attention",
+        q,
+        k,
+        v,
+        q_cu_seqlens,
+        k_cu_seqlens,
+        scale,
+        device_type=q.device.type,
+    )
+
+
+def rotary_interleaved(inputs: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
+    """Apply rotary embeddings to adjacent feature pairs."""
+    return dispatch_op(
+        "rotary_interleaved", inputs, cos, sin, device_type=inputs.device.type
+    )
