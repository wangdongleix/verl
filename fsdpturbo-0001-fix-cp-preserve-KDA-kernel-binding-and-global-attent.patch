+
+### Kimi KDA Ulysses 与 FSDP
+
+KDA 的 Ulysses forward 在安装时绑定原始 forward 模块中的 `chunk_kda`，
+避免 FSDP 动态包装类改变模块路径后找不到算子。verl 非 TND CP + R3 适配使用此路径。
+
+Ulysses 从各分片的 causal mask 收集有效 key 位置，重建全局 causal mask 时保留左右 padding，
+避免不同图像展开长度的样本对 padding key 产生注意力。
diff --git a/fsdp_turbo/distributed/context_parallel/ulysses/ulysses_attention.py b/fsdp_turbo/distributed/context_parallel/ulysses/ulysses_attention.py
index d541d36..732084b 100644
--- a/fsdp_turbo/distributed/context_parallel/ulysses/ulysses_attention.py
+++ b/fsdp_turbo/distributed/context_parallel/ulysses/ulysses_attention.py
@@ -27,7 +27,16 @@ def _full_causal_mask_from_local(attention_mask: torch.Tensor | None, query, gro
         device=query.device,
         dtype=query.dtype,
     )
-    return mask.masked_fill(~causal.view(1, 1, full_seq_len, full_seq_len), torch.finfo(query.dtype).min)
+    allowed = causal.view(1, 1, full_seq_len, full_seq_len)
+    if attention_mask is not None:
+        # The last local causal row exposes every non-padding local key.
+        local_keys = attention_mask[:, :, -1, :]
+        if local_keys.dtype != torch.bool:
+            local_keys = local_keys == 0
+        key_masks = [torch.empty_like(local_keys) for _ in range(dist.get_world_size(group))]
+        dist.all_gather(key_masks, local_keys.contiguous(), group=group)
+        allowed = allowed & torch.cat(key_masks, dim=-1).unsqueeze(-2)
+    return mask.masked_fill(~allowed, torch.finfo(query.dtype).min)
 
 
 def ulysses_context_parallel_attention(
