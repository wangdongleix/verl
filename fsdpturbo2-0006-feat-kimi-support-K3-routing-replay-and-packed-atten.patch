+            actual_seq_qlen=query_ends,
+            actual_seq_kvlen=key_ends,
+            scale=scaling,
+            keep_prob=1.0 - dropout,
+            sparse_mode=3,
+        )[0]
+        return output.unsqueeze(0), None
