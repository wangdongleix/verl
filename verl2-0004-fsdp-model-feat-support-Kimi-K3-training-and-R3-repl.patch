+def test_kimi_packed_transport_rejects_other_model_types():
+    tensor = torch.arange(2 * 3 * 8, dtype=torch.float32).reshape(2, 3, 8)
+    name = "model.layers.7.block_sparse_moe.experts.gate_up_proj.__verl_packed_local__.4"
