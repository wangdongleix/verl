 class KDAUlyssesTests(unittest.TestCase):
+    def test_kernel_binding_survives_fsdp_class_replacement(self):
+        def original_forward(module, hidden_states, **kwargs):
+            raise AssertionError("CP must execute the distributed forward")
+
+        wrapped_class = type(
+            "FSDPKimiDeltaAttention",
+            (torch.nn.Module,),
+            {
+                "__module__": "torch.distributed.fsdp._fully_shard._fully_shard",
+            },
+        )
+        module = wrapped_class()
+        module.num_heads = 2
+        module.head_dim = module.head_k_dim = 2
+        module.use_full_rank_gate = True
+        module.gate_lower_bound = None
+        module.config = SimpleNamespace(skip_kda_recompute=False)
+        module.A_log = torch.nn.Parameter(torch.zeros(2))
+        module.dt_bias = torch.nn.Parameter(torch.zeros(4))
+        for name in (
+            "q_proj",
+            "k_proj",
+            "v_proj",
+            "f_a_proj",
+            "f_b_proj",
+            "g_proj",
+            "o_proj",
+        ):
+            setattr(module, name, torch.nn.Linear(4, 4, bias=False))
+        module.b_proj = torch.nn.Linear(4, 2, bias=False)
+        module.q_conv1d = module.k_conv1d = module.v_conv1d = torch.nn.Identity()
+        module.o_norm = lambda output, gate: output
+        hidden = torch.randn(1, 3, 4, requires_grad=True)
+        kernel = mock.Mock(side_effect=lambda **kwargs: (kwargs["v"], None))
+        with (
+            mock.patch(__name__ + ".chunk_kda", kernel, create=True),
+            mock.patch("torch.distributed.get_world_size", return_value=2),
+            mock.patch("torch.distributed.get_rank", return_value=0),
+            mock.patch(
+                "fsdp_turbo.modules.kda._sequence_to_local_channels",
+                side_effect=lambda tensor, group: tensor[..., : tensor.size(-1) // 2],
+            ),
+            mock.patch(
+                "fsdp_turbo.modules.kda._local_channels_to_sequence",
+                side_effect=lambda tensor, group: tensor.repeat(1, 1, 2),
+            ),
+            mock.patch(
+                "fsdp_turbo.modules.kda._sliced_short_convolution",
+                side_effect=lambda conv, projected, rank: projected,
+            ),
+        ):
+            forward = get_ulysses_kda_forward(original_forward, object())
+            output = forward(module, hidden)
+            output.sum().backward()
+        kernel.assert_called_once()
+        self.assertEqual(output.shape, hidden.shape)
+        self.assertIsNotNone(module.v_proj.weight.grad)
+
