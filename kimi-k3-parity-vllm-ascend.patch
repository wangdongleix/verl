+def _kimi_kda_fp32_o_proj_forward(
+    projection: nn.Module, input_: torch.Tensor
+) -> torch.Tensor | tuple[torch.Tensor, nn.Parameter | None]:
+    """Delay KDA row-parallel o_proj rounding until after TP reduction.
+
+    The BF16 row-parallel path rounds each TP rank's local GEMM before the
+    all-reduce. The FSDP actor evaluates one full-width GEMM, so cancellation
+    makes the two paths differ materially. Compute local GEMMs and the TP sum
+    in FP32, then cast once to the model dtype.
+    """
+    if not projection.input_is_parallel:
+        raise RuntimeError("KDA FP32 o_proj parity path requires parallel input")
+    if projection.bias is not None:
+        raise RuntimeError("KDA FP32 o_proj parity path expects bias=False")
+    if not projection.reduce_results:
+        raise RuntimeError("KDA FP32 o_proj parity path requires TP reduction")
+
+    input_base = torch_npu.npu_format_cast(input_, 2)
+    weight_base = torch_npu.npu_format_cast(projection.weight, 2)
+    output_parallel = F.linear(input_base.float(), weight_base.float())
+    if projection.tp_size > 1:
+        output_fp32 = tensor_model_parallel_all_reduce(output_parallel)
+    else:
+        output_fp32 = output_parallel
+    output = output_fp32.to(input_.dtype)
+    if not projection.return_bias:
+        return output
+    return output, None
+
