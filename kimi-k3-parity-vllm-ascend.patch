+from __future__ import annotations
+
+import types
+
+import numpy as np
+import pytest
+
+from vllm.model_executor.layers.fused_moe import routed_experts_capturer
+from vllm_ascend.patch.kimi_full_r3_schema import (
+    install_kimi_full_r3_schema_patch,
+)
+
+
+def _kimi_config():
+    return types.SimpleNamespace(
+        model_type="kimi_k3",
+        num_experts_per_token=8,
+        num_experts=16,
+        num_hidden_layers=2,
+    )
+
+
+def _construct_real_manager(monkeypatch):
+    """Run the patched wrapper and the real upstream manager initializer."""
+
+    class FakeFullAttentionSpec:
+        block_size = 2
+
+    monkeypatch.setattr(
+        routed_experts_capturer,
+        "FullAttentionSpec",
+        FakeFullAttentionSpec,
+    )
+    hf_config = _kimi_config()
+    vllm_config = types.SimpleNamespace(
+        model_config=types.SimpleNamespace(hf_text_config=hf_config)
+    )
+    kv_cache_config = types.SimpleNamespace(
+        kv_cache_groups=[
+            types.SimpleNamespace(kv_cache_spec=FakeFullAttentionSpec())
+        ],
+        num_blocks=2,
+    )
+    manager = routed_experts_capturer.RoutedExpertsManager(
+        vllm_config,
+        kv_cache_config,
+    )
+    return manager, hf_config
+
+
+def test_all_process_schema_reserves_ids_and_bf16_weight_bytes():
+    install_kimi_full_r3_schema_patch()
+    assert routed_experts_capturer._get_num_experts_per_tok(_kimi_config()) == 24
+    assert (
+        routed_experts_capturer.RoutedExpertsManager.__init__.__module__
+        == "vllm_ascend.patch.kimi_full_r3_schema"
+    )
+
+
+def test_scheduler_real_init_handles_kimi_spelling_and_uses_packed_width(
+    monkeypatch,
+):
+    install_kimi_full_r3_schema_patch()
+    manager, hf_config = _construct_real_manager(monkeypatch)
+
+    assert manager.routed_experts_by_slot.shape == (4, 2, 24)
+    assert manager._kimi_full_r3_schema_active is True
+    assert manager._kimi_full_r3_logical_topk == 8
+    assert not hasattr(hf_config, "num_experts_per_tok")
+
+
+def test_scheduler_store_and_retrieve_are_fail_closed(monkeypatch):
+    install_kimi_full_r3_schema_patch()
+    manager, _ = _construct_real_manager(monkeypatch)
+
+    data = np.arange(2 * 2 * 24, dtype=np.int32).reshape(2, 2, 24)
+    manager.store_batch(data, np.array([0, 1], dtype=np.int32))
+    restored = manager.get([0], num_tokens=2)
+    np.testing.assert_array_equal(
+        restored,
+        data.astype(manager.routed_experts_by_slot.dtype),
+    )
+
+    with pytest.raises(RuntimeError, match="scheduler store schema mismatch"):
+        manager.store_batch(data[..., :8], np.array([0, 1], dtype=np.int32))
