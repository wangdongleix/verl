+def test_kimi_k3_text_loader_maps_packed_local_rows_to_global_experts():
+    calls = []
+
+    def make_parameter(target_name):
+        parameter = nn.Parameter(torch.zeros(1))
+
+        def weight_loader(param, loaded_weight, weight_name, **kwargs):
+            assert param is parameter
+            calls.append((target_name, loaded_weight.clone(), weight_name, kwargs))
+            return True
+
+        parameter.weight_loader = weight_loader
+        return parameter
+
+    prefix = "model.layers.1.block_sparse_moe.experts"
+    params = {
+        f"{prefix}.w13_weight": make_parameter(f"{prefix}.w13_weight"),
+        f"{prefix}.w2_weight": make_parameter(f"{prefix}.w2_weight"),
+    }
+    model = KimiK3TextModel.__new__(KimiK3TextModel)
+    nn.Module.__init__(model)
+    model.config = SimpleNamespace(
+        num_experts=8,
+        num_hidden_layers=2,
+        num_nextn_predict_layers=0,
+    )
+    model.named_parameters = lambda: iter(params.items())
+
+    gate_up = torch.arange(2 * 3 * 4, dtype=torch.float32).reshape(2, 3, 4)
+    down = torch.arange(2 * 2 * 3, dtype=torch.float32).reshape(2, 2, 3)
+    loaded = model.load_weights(
+        iter(
+            [
+                (f"{prefix}.gate_up_proj.__verl_packed_local__.4", gate_up),
+                (f"{prefix}.down_proj.__verl_packed_local__.4", down),
+            ]
+        )
+    )
+
+    assert loaded == {f"{prefix}.gate_up_proj", f"{prefix}.down_proj"}
+    assert [(call[0], call[3]["expert_id"], call[3]["shard_id"]) for call in calls] == [
+        (f"{prefix}.w13_weight", 4, "w1"),
+        (f"{prefix}.w13_weight", 4, "w3"),
+        (f"{prefix}.w13_weight", 5, "w1"),
+        (f"{prefix}.w13_weight", 5, "w3"),
+        (f"{prefix}.w2_weight", 4, "w2"),
+        (f"{prefix}.w2_weight", 5, "w2"),
+    ]
+    assert all(call[3]["return_success"] for call in calls)
+    assert all(call[2].endswith(".weight") for call in calls)
+    torch.testing.assert_close(calls[0][1], gate_up[0, :, :2].t().contiguous())
+    torch.testing.assert_close(calls[1][1], gate_up[0, :, 2:].t().contiguous())
+    torch.testing.assert_close(calls[4][1], down[0].t().contiguous())
+
