+        input_: torch.Tensor,
+        acl_format: int,
+        *,
+        customize_dtype: int | None = None,
+        input_dtype: int | None = None,
+    ) -> torch.Tensor:
+        del acl_format, customize_dtype, input_dtype
+        return torch.empty_strided(
