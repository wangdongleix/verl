+def _make_efsdp_shard_placement(expert, placements, enable_lp_all_gather):
+    # Parameter identity is resolved after EP has installed its DTensors.
+    # Shape checks belong here because configuration initialization has no model.
+    dimensions = {}
+    for name, dim in placements:
+        parameter = expert.get_parameter(name)
+        if dim >= parameter.ndim:
+            raise ValueError(f"eFSDP dimension {dim} is out of range for {name} with shape {tuple(parameter.shape)}")
+        if enable_lp_all_gather and dim != 0:
+            raise ValueError("Low-precision all-gather requires dim-0 eFSDP sharding")
+        if id(parameter) in dimensions and dimensions[id(parameter)] != dim:
+            raise ValueError(f"Conflicting eFSDP dimensions for shared parameter {name}")
+        dimensions[id(parameter)] = dim
+
+    def shard_placement_fn(parameter: torch.nn.Parameter) -> Shard:
+        default_dim = 0 if enable_lp_all_gather or parameter.ndim < 2 else 1
+        return Shard(dimensions.get(id(parameter), default_dim))
+
+    return shard_placement_fn
+
