 from pathlib import Path
 
 import torch
+import pytest
 
 
 _MODULE_PATH = Path(__file__).parents[3] / "fsdp_turbo" / "ops" / "npu" / "permute.py"
@@ -27,3 +28,19 @@ def test_unpermute_npu_preserves_activation_dtype(monkeypatch):
     output = npu_permute.unpermute_npu(activations, sorted_indices, router_probs)
 
     assert output.dtype == activations.dtype
+
+
+@pytest.mark.skipif(not hasattr(torch, "npu") or not torch.npu.is_available(), reason="requires NPU autocast")
+@pytest.mark.parametrize("weighted", [False, True])
+def test_eager_unpermute_preserves_dtype_under_npu_autocast(weighted):
+    from fsdp_turbo.ops.cpu.permute import unpermute_cpu
+
+    x = torch.arange(16, device="npu", dtype=torch.bfloat16).reshape(4, 4).requires_grad_()
+    probs = torch.full((2, 2), 0.5, device="npu") if weighted else None
+    with torch.autocast("npu", dtype=torch.bfloat16):
+        output = unpermute_cpu(x, torch.arange(4, device="npu"), probs)
+    assert output.dtype == x.dtype
+    expected = x.reshape(2, 2, 4).float().mean(1).to(x.dtype) if weighted else x
+    torch.testing.assert_close(output, expected)
+    output.float().sum().backward()
+    torch.testing.assert_close(x.grad, torch.full_like(x, 0.5 if weighted else 1.0))
